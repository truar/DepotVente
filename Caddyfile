{
    auto_https off
}

# HTTP -> HTTPS redirect (so http://bourseauski.local lands on HTTPS)
:80 {
    redir https://{host}{uri} permanent
}

# HTTPS entrypoint - this is what client PCs connect to
:443 {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/cert-key.pem

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle {
        reverse_proxy frontend:80
    }
}
